{
  "name": "qr-code-scanner-interface",
  "private": true,
  "version": "2.0.0",
  "description": "QR Code Scanner Interface - AWT Mini Project (FA-1 + FA-2) - PRN 125M1H050",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "json-server --watch db.json --port 3001",
    "start": "concurrently -n WEB,API -c cyan,magenta \"npm run dev\" \"npm run server\"",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && gh-pages -d dist"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "gh-pages": "^6.1.1",
    "jsdom": "^25.0.0",
    "json-server": "0.17.4",
    "vite": "^5.4.8",
    "vitest": "^2.1.1"
  }
}
